maintainer="Leandro <leandro@example.com>"
pkgname=platina-tweaks
pkgver=1
pkgrel=0
pkgdesc="Local tweaks for Xiaomi Mi 8 Lite (no suspend, usb0 unmanaged, display modules)"
url="https://postmarketos.org"
arch="noarch"
license="MIT"
options="!check"
source="
	99-nosuspend-logind.conf
	99-nosuspend-sleep.conf
	99-usb0.conf
	display.conf
"
builddir="$srcdir"

package() {
	install -Dm644 "$srcdir"/99-nosuspend-logind.conf "$pkgdir"/etc/elogind/logind.conf.d/99-nosuspend.conf
	install -Dm644 "$srcdir"/99-nosuspend-sleep.conf "$pkgdir"/etc/elogind/sleep.conf.d/99-nosuspend.conf
	install -Dm644 "$srcdir"/99-usb0.conf "$pkgdir"/etc/NetworkManager/conf.d/99-usb0.conf
	install -Dm644 "$srcdir"/display.conf "$pkgdir"/etc/modules-load.d/display.conf
}
